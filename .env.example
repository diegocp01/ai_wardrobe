# Uses the locally signed-in Codex CLI first. Set to "api" to force the
# OPENAI_API_KEY path, or "codex" to disable API-key fallback entirely.
WARDROBE_IMPORT_PROVIDER=auto
WARDROBE_CODEX_BIN=codex
# Leave blank to use the model selected by your Codex installation.
WARDROBE_CODEX_MODEL=
WARDROBE_CODEX_ANALYSIS_TIMEOUT_MS=120000
WARDROBE_CODEX_IMAGE_TIMEOUT_MS=300000

# Optional fallback provider. Not required when `codex login status` succeeds.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# The dev server is intentionally loopback-only by default.
WARDROBE_HOST=127.0.0.1
